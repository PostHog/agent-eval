{
  "name": "agent-eval",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "agent-eval": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "npm run build && node dist/cli.js serve",
    "dev:server": "node --import tsx src/cli.ts serve --no-open",
    "dev:web": "vite --config web/vite.config.ts",
    "start": "node dist/cli.js serve",
    "build": "node --import tsx scripts/build.ts",
    "db:generate": "prisma generate",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --import tsx --test test/*.test.ts && npm run test:web",
    "test:web": "tsx --tsconfig web/tsconfig.json --test web/test/*.test.tsx",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@nestjs/common": "11.2.9",
    "@nestjs/core": "11.2.9",
    "@nestjs/platform-express": "11.2.9",
    "@posthog/quill": "0.3.0-beta.33",
    "@prisma/client": "6.19.3",
    "chalk": "6.0.0",
    "dompurify": "3.4.17",
    "dotenv": "17.4.2",
    "marked": "18.0.11",
    "nest-commander": "3.21.0",
    "open": "10.2.0",
    "p-limit": "6.2.0",
    "posthog-js": "^1.447.15",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typebox": "1.3.27",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/express": "5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "^29.1.1",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  },
  "overrides": {
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-codemode": "1.1.0",
    "@earendil-works/pi-mcp": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@earendil-works/pi-telemetry": "1.1.0",
    "@earendil-works/chord": "1.1.0",
    "ws": "8.22.0"
  }
}
